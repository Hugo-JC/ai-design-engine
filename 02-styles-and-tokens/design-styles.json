{
  "name": "AI Design Engine Preset Tokens",
  "version": 3,
  "selection_rules": {
    "how_to_choose": "Usar `node tools/route.js \"<pedido>\"`: o nicho decide o style_id (local-presets.json). Sem correspondência de nicho, o router pontua `keywords` destes estilos; só depois cai no fallback. Registar a decisão no DESIGN BRIEF.",
    "tie_breaker": "Em caso de empate, escolher o estilo cuja 'description' descreve melhor o nicho. Nunca sortear.",
    "mode_rule": "Respeitar o campo 'mode' do estilo. Só trocar para a variante dark/light do mesmo nicho quando o prompt o sugerir (ex: 'sofisticado', 'premium', 'noturno' -> variante dark).",
    "override_rule": "Se o utilizador pedir cores ou fontes específicas, estas substituem o token, mas contraste WCAG AA e regras de anti-patterns continuam a valer."
  },
  "global_constraints": {
    "spacing_grid": "base 8px; meio-passo de 4px permitido até 16px (4, 12). Valores >16px fora de múltiplos de 8 são desvios a justificar.",
    "heading_tracking_range": "[-0.02em, 0em] por defeito; cada estilo declara `heading_tracking_range` e pode alargar para cima (nunca abaixo de -0.02em).",
    "min_text_contrast": "4.5:1 (texto normal) e 3:1 (texto grande ≥24px ou ≥18.66px bold)",
    "accent_max_share_by_intensity": {
      "calm": 10,
      "balanced": 15,
      "loud": 25
    },
    "accent_max_share_note": "percentagem da superfície visível. A cor do PRODUTO (lata, embalagem, ilustração) não conta como accent de UI, mas tem de ser declarada no brief.",
    "precedence": [
      "requisitos funcionais e acessibilidade",
      "pedido explícito do utilizador (cores, fontes, estilo)",
      "tokens do style_id",
      "regras gerais (01-rules)",
      "avisos do validador (heurísticos)"
    ]
  },
